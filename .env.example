DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Leave DROPBOX_ROOT empty — articles are stored at /articles in the app's
# Dropbox root. (In GitHub Actions secrets, which reject empty values, enter a
# single space; the readers trim it back to empty.)
DROPBOX_ROOT=

NEWS_USER_AGENT=NS-Digest/0.1 (+https://your-domain.example)
